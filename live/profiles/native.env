# Persisted x86 live compute profile. Secrets remain in live/.env.
export NARROWGATE_LIVE_PROFILE_NAME="native"
export NARROWGATE_CPP_QUOTE_CORE="1"
# The production Cascade Lake A/B benchmark admits the fused quote core and
# stateless common-side policy boundary. Stateful policy clocks and routing
# remain outside this stage until their own semantic parity is complete.
export NARROWGATE_CPP_QUOTE_POLICY_STAGE="1"
export NARROWGATE_CPP_SIGNAL_FEATURES="1"
export NARROWGATE_CPP_GLOBAL_FLOW="1"
export NARROWGATE_CPP_LIVE_ROUTING="1"
export NARROWGATE_CPP_REPLACE_CONTINUATION="1"
export NARROWGATE_CPP_COOLDOWN="1"
export NARROWGATE_CPP_ORDER_ACTION_PLAN="1"
# Qualification-only until the final-order tail has independent trace parity.
export NARROWGATE_CPP_FINAL_ORDER_PLAN="0"
export NARROWGATE_CPP_STRICT="1"

# Prevent nested numeric-library thread pools from adding live tail jitter.
export OMP_NUM_THREADS="1"
export OPENBLAS_NUM_THREADS="1"
export MKL_NUM_THREADS="1"
export NUMEXPR_NUM_THREADS="1"
export MALLOC_ARENA_MAX="1"
