    "candidate_induced_forced_decisions_cannot_release_wait": true,
    "missing_or_regressing_generation_policy": "fail_closed"
  },
  "paired_fork_actions": {
    "ADD_NOW": {
      "at_assignment": "submit the same side-specific add that pi0 would submit when permitted, with identical executable price, quantity, GTX, activation, queue, and latency semantics",
      "continuation": "at tau_plus and afterward use frozen pi0"
    },
    "WAIT_ONE_EXTERNAL_EPOCH": {
      "at_assignment": "do not submit the side-specific add",
      "during_wait": "candidate-induced order or campaign events cannot create an earlier redecision",
      "continuation": "at the same tau_plus as ADD_NOW, re-evaluate both arms under frozen pi0"
    },
    "second_assignment_before_joint_washout": "forbidden",
    "independent_market_path": false,
