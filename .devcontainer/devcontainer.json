{
  "name": "NarrowGate",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -e '.[dev]' && narrowgate doctor",
  "remoteEnv": {
    "NARROWGATE_DATA_ROOT": "/workspace/data",
    "MM_DATA_ROOT": "/workspace/data"
  }
}
