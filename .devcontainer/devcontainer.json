{
  "name": "NarrowGate",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "NARROWGATE_INSTALL_TARGET": ".[all]"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.cpptools"
      ]
    }
  },
  "mounts": [
    "source=narrowgate-marketdata,target=/narrowgate/marketdata,type=volume",
    "source=narrowgate-cache,target=/narrowgate/cache,type=volume"
  ],
  "postCreateCommand": "mkdir -p \"$NARROWGATE_DATA_ROOT\" \"$NARROWGATE_CACHE_ROOT\" && python -m pip install --no-deps --no-build-isolation -e . && narrowgate doctor",
  "remoteEnv": {
    "NARROWGATE_MARKETDATA_ROOT": "/narrowgate/marketdata",
    "NARROWGATE_DATA_ROOT": "/narrowgate/marketdata/NarrowGate_BTCUSDC",
    "NARROWGATE_CACHE_ROOT": "/narrowgate/cache",
    "MM_DATA_ROOT": "/narrowgate/marketdata/NarrowGate_BTCUSDC"
  }
}
